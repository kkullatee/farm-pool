# Server-side secrets. Locally: copy to backend/.env and fill in.
# On Railway: set these as service Variables instead (never commit real keys).

# Photo screening, voice extraction and pool coordination (Claude)
ANTHROPIC_API_KEY=

# Voice transcription (ElevenLabs speech-to-text)
ELEVENLABS_API_KEY=

# Optional: override the ElevenLabs STT model (defaults to scribe_v1)
# ELEVENLABS_STT_MODEL=scribe_v1
