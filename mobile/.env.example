# Public backend URL baked into the Expo app. Copy to mobile/.env.
# Local development: your machine's LAN IP, e.g. http://192.168.0.21:8000
# Production: the Railway public domain, e.g. https://<your-app>.up.railway.app
# No secrets here: EXPO_PUBLIC_* values ship inside the app bundle.
# After changing this file, restart Expo with: npx expo start -c
EXPO_PUBLIC_API_URL=
